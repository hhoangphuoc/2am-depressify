{
  "description": "Shared Outcome fixture (#21): the Outcome score, the ranking of kinds, the Brief's guidance and the Suggestion an answer belongs to. Read by the functions' tests (firebase/functions/src/outcomes.ts: the score and the target), core's Kotlin tests (app.depressify.core.learning) and the seed's tests (outcomeScore only). The rules are described in docs/firestore-schema.md, 'Outcomes and learning what helps'. Compare numbers with an absolute tolerance of `tolerance`; null means no score.",
  "rule": {
    "score": "null when tried is null (unanswered, or prefer not to say); -0.1 when tried is false, whatever felt and the steps say; otherwise clamp(0.7 * feeling + 0.3 * clamp(objectiveChange, -1, 1), -1, 1), where feeling = (felt - 3) / 2 for felt 1 to 5 and 0 when not given, and a missing objectiveChange counts as 0",
    "objectiveChange": "the oriented steps comparison with Baseline on the daily record of the date the Suggestion was made",
    "rank": "kinds with at least one numeric outcomeScore, by mean descending, then count descending, then contract order of SuggestionKind",
    "guidance": "preferred = the first 3 of rank; random() is called once; when it is below 0.2, tryNew = the first kind in contract order with no score, else the kind outside preferred with the fewest scores (ties in contract order); otherwise tryNew = null",
    "target": "the most recent (suggestedAtMillis, then id) accepted Suggestion with suggestedAtMillis before the Check-in started, not in excludeIds, and with no Outcome (outcomeCheckInId null, tried null and outcomeScore null) or with outcomeCheckInId equal to this Check-in; null when there is none",
    "tolerance": 1e-09
  },
  "scores": [
    {
      "name": "unknown until the Patient answers",
      "tried": null,
      "felt": 5,
      "objectiveChange": 1.0,
      "expected": null
    },
    {
      "name": "not tried is slightly negative, whatever the steps",
      "tried": false,
      "felt": null,
      "objectiveChange": 2.0,
      "expected": -0.1
    },
    {
      "name": "not tried ignores a feeling",
      "tried": false,
      "felt": 5,
      "objectiveChange": null,
      "expected": -0.1
    },
    {
      "name": "felt 5 with no step change is 0.7",
      "tried": true,
