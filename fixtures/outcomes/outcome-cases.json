      "objectiveChange": null,
      "expected": 0.7
    },
    {
      "name": "felt 1 with no step change is -0.7",
      "tried": true,
      "felt": 1,
      "objectiveChange": null,
      "expected": -0.7
    },
    {
      "name": "felt 3 is neutral; the steps add 0.3 times the change",
      "tried": true,
      "felt": 3,
      "objectiveChange": 0.5,
      "expected": 0.15
    },
    {
      "name": "tried with no feeling and no step change is 0",
      "tried": true,
      "felt": null,
      "objectiveChange": null,
      "expected": 0.0
    },
    {
      "name": "tried with no feeling: the steps alone",
      "tried": true,
      "felt": null,
      "objectiveChange": -0.8,
      "expected": -0.24
    },
    {
      "name": "felt 4 and a step change of 1",
      "tried": true,
      "felt": 4,
      "objectiveChange": 1.0,
      "expected": 0.65
    },
    {
      "name": "the step change is clamped to 1 before it is weighted",
      "tried": true,
      "felt": 5,
      "objectiveChange": 3.0,
      "expected": 1.0
    },
    {
      "name": "a large step change cannot turn a bad feeling good",
      "tried": true,
      "felt": 1,
      "objectiveChange": 3.0,
      "expected": -0.4
    },
    {
      "name": "the step change is clamped to -1 before it is weighted",
      "tried": true,
      "felt": 2,
      "objectiveChange": -2.5,
      "expected": -0.65
    },
    {
      "name": "a feeling outside 1 to 5 counts as not given",
      "tried": true,
      "felt": 7,
      "objectiveChange": 0.5,
      "expected": 0.15
    }
  ],
