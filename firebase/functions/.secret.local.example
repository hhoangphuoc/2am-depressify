# Copy to .secret.local (gitignored) to give the Functions emulator real keys.
# On a deployed project use: firebase functions:secrets:set <NAME> --project prod

# Gemini API key from a paid-tier project. Used for Intake and the Digest (Interactions API).
# With it set, text pasted in the emulator goes to Gemini with storage off: paste only fictional reports.
GEMINI_API_KEY=

# Reserved for the Map tool function (Maps agent tools: weather, places, walking routes). Not read yet.
# MAPS_API_KEY=
