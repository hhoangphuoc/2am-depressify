{
  "name": "twoam-seed",
  "private": true,
  "type": "module",
  "description": "Creates and resets the three Demo Patients (synthetic data), and the live demo Patient's mock history, with the Admin SDK.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "seed": "node seed.js",
    "seed-live-patient": "node seed-live-patient.js",
    "allow-clinician": "node allow-clinician.js",
    "silence-test": "node silence-test.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && node --test \"test/unit/*.test.js\"",
    "test:emulator": "node --test --test-concurrency=1 \"test/emulator/*.test.js\""
  },
  "dependencies": {
    "firebase-admin": "14.5.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "22.20.5",
    "firebase": "13.3.0",
    "typescript": "6.0.3"
  }
}
