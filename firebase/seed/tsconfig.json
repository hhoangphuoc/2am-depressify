{
  // Type-checks the seed's JavaScript (JSDoc) against the data contract in
  // ../functions/src/types.ts, so a generated document with a missing, extra or mistyped field
  // fails `npm test`. Nothing is emitted; Node runs the .js files directly.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["seed.js", "seed-live-patient.js", "allow-clinician.js", "silence-test.js", "src", "test"]
}
