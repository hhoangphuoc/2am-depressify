# Copy to secrets.properties (gitignored) to point the Android app at a real Firebase project.
# Without the file the app uses the emulator-only project demo-twoam on 127.0.0.1.
# These values come from the Android app registered in the Firebase console (package app.depressify.patient).
firebase.projectId=your-project
firebase.applicationId=1:1234567890:android:abcdef
firebase.apiKey=AIza...
# Leave empty to stop using the emulators in debug builds
firebase.emulatorHost=
# The Clinician a new Patient is linked to. Allow it first: npm run allow-clinician in firebase/seed.
demo.clinicianEmail=
# Optional: act as a seeded Demo Patient (demo-steady, demo-declining or demo-sparse) so the
# Companion has six weeks of history to draw on. Leave out to be the phone's own Patient.
# demo.patientId=demo-declining

# Optional: a Maps SDK for Android key for the map of places on Today. Create a separate key in
# Google Cloud, restricted to the Maps SDK for Android and to this app (package
# app.depressify.patient plus your signing certificate's SHA-1). Without it, Today lists the places
# with no map.
# maps.apiKey=AIza...

# No Gemini key and no server Maps key (Places) belongs here: those are function secrets and never
# reach the phone (ADR 0002).
